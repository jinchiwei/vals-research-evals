results/**/stderr.txt
results/**/agent-stderr.txt
results/**/agent-finalize-stderr.txt

# Private PCNSL inputs and patient-level outputs stay on SCS/FAC.
pcnsl/release_candidate/
pcnsl/runs/
**/*_PHI*
**/private_predictions/
**/tasks_local_only/
**/crosswalk*.csv

# Archives can bundle unreviewed files. Rebuild task/source archives locally.
*.zip
exp/
.autoresearch/
**/.signed-download-url
**/.download-proxy-env.json
